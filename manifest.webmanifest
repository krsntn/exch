{
  "name": "Exch",
  "short_name": "Exch",
  "description": "Compare two exchange quotes and convert shop prices to your home currency.",
  "start_url": "./index.html?launch",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111317",
  "theme_color": "#111317",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Compare", "url": "./index.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Convert", "url": "./convert.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
